# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local scratch (do not commit derived scratch output that isn't needed)
/tmp

# If you ever install a static-server dependency locally
node_modules/

# Python caches
__pycache__/
*.pyc

# Local screenshots (used for review/feedback, not part of the published site)
/Screenshot*.png
/Screenshot*.jpg
/Screen Shot*.png
/Screen Shot*.jpg

# Source publications kept locally, not published: ~64 MB of CBI "تحولات بازار
# معاملات مسکن" PDFs + extractions. Only the derived CSVs under data/ are tracked,
# so that the repo and every clone stay small. See data/sources.csv for provenance.
/data/*گزارش تحولات*/
